      values.forEach(v => {
        const o = document.createElement('option')
        o.value = v; o.textContent = v
        select.appendChild(o)
      })
    }
    fillSelect(el.grade, GRADES)
    fillSelect(el.subject, BASE_SUBJECTS)

    function mergeSubjects() {
