{
  "expo": {
    "name": "GreenShelf",
    "slug": "greenshelf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "greenshelf",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.greenshelf.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "GreenShelf needs access to your photos so you can add pictures of a book you are listing.",
        "NSCameraUsageDescription": "GreenShelf needs camera access so you can take a photo of a book you are listing."
      }
    },
    "android": {
      "package": "com.greenshelf.oman",
      "adaptiveIcon": {
        "backgroundColor": "#2f5e44",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#f6f1e6",
          "dark": {
            "backgroundColor": "#16140f"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GreenShelf needs access to your photos so you can add pictures of a book you are listing.",
          "cameraPermission": "GreenShelf needs camera access so you can take a photo of a book you are listing."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
